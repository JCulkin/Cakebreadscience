#fff" opacity="1.00">Na⁺</text><circle cx="994" cy="994" r="60" fill="url(#tcl)" opacity="1.00"/><text x="994" y="1006" text-anchor="middle" font-size="34" font-weight="900" fill="#fff" opacity="1.00">Cl⁻</text><circle cx="1126" cy="994" r="36" fill="url(#tna)" opacity="1.00"/><text x="1126" y="1004" text-anchor="middle" font-size="26" font-weight="900" fill="#fff" opacity="1.00">Na⁺</text><circle cx="1258" cy="994" r="60" fill="url(#tcl)" opacity="1.00"/><text x="1258" y="1006" text-anchor="middle" font-size="34" font-weight="900" fill="#fff" opacity="1.00">Cl⁻</text><circle cx="1390" cy="994" r="36" fill="url(#tna)" opacity="1.00"/><text x="1390" y="1004" text-anchor="middle" font-size="26" font-weight="900" fill="#fff" opacity="1.00">Na⁺</text><circle cx="1522" cy="994" r="60" fill="url(#tcl)" opacity="1.00"/><text x="1522" y="1006" text-anchor="middle" font-size="34" font-weight="900" fill="#fff" opacity="1.00">Cl⁻</text><circle cx="1654" cy="994" r="36" fill="url(#tna)" opacity="1.00"/><text x="1654" y="1004" text-anchor="middle" font-size="26" font-weight="900" fill="#fff" opacity="1.00">Na⁺</text></svg><div class="tbox" style=""><div class="tkick">IGCSE Chemistry · 1 Principles of chemistry</div><h1>1f Ionic<br><span class="em">bonding</span></h1></div></section>

  <section class="ps"><h2>Ions</h2><div class="big">An ion is a <span class="em">charged</span> atom or molecule</div><div class="row"><div class="col"><div class="mid" data-s="1">K<sup>+</sup> is a potassium ion<br>NO<sub>3</sub><sup>−</sup> is a nitrate ion</div><div class="mid mt" data-s="2">Electrons lost or gained = size of the charge</div><div class="mid mt2 grey" data-s="3">lost 2 electrons → <b>2+</b><br>gained 2 electrons → <b>2−</b></div></div><div class="fig" style="flex-direction:column;gap:20px" data-s="1"><img decoding="async" loading="lazy" src="img/ki.webp" alt="" style="max-height:220px"><img decoding="async" loading="lazy" src="img/nitrate.webp" alt="" style="max-height:260px"></div></div></section>

  <section class="ps"><h2>Simulation</h2><div style="margin:auto 0"><a class="linkcard" href="https://javalab.org/en/ionic_bond_2_en/" target="_blank" rel="noopener"><span class="ic">⚛</span><span class="lt"><b>Simulation</b>Ionic bonding: watch atoms transfer electrons and become ions<small>javalab.org ↗</small></span></a></div></section>
  <section class="ps" data-nomatch><h2>Sodium → sodium ion</h2><div class="big">Na &nbsp; 2.8.<span class="em">1</span> &nbsp;→&nbsp; <span data-s="1">loses 1 electron →</span> <span data-s="2">Na<sup class="em">+</sup> &nbsp; 2.8</span></div><div class="fig mt2" data-s="2" style="flex:1;min-height:0"><svg viewBox="0 0 920 340" style="width:100%;height:100%;max-height:430px;display:block" role="img" aria-label="Sodium atom (2.8.1) loses its single outer electron to form a sodium ion [Na]+ (2.8)" font-family="Barlow,Arial,sans-serif">
  <defs>
    <marker id="dknaa" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#c8001e"/></marker>
    <radialGradient id="dknan" cx="35%" cy="30%" r="70%"><stop offset="0%" stop-color="#e1bee7"/><stop offset="55%" stop-color="#8e24aa"/><stop offset="100%" stop-color="#4a148c"/></radialGradient>
    <radialGradient id="dknae" cx="35%" cy="30%" r="70%"><stop offset="0%" stop-color="#e0f2fe"/><stop offset="50%" stop-color="#38bdf8"/><stop offset="100%" stop-color="#0369a1"/></radialGradient>
  </defs>
  <!-- Left card: Na atom 2.8.1 -->
  <rect x="10" y="10" width="350" height="320" rx="18" fill="#fff" stroke="#111" stroke-width="4.5"/>
  <text x="185" y="42" text-anchor="middle" font-size="24" font-weight="900" fill="#4a148c">SODIUM ATOM (2.8.1)</text>
  <!-- 3 shells -->
  <circle cx="185" cy="182" r="46" fill="none" stroke="#94a3b8" stroke-width="3"/>
  <circle cx="185" cy="182" r="80" fill="none" stroke="#64748b" stroke-width="3"/>
  <circle cx="185" cy="182" r="114" fill="none" stroke="#c8001e" stroke-width="3.5" stroke-dasharray="8 6"/>
  <!-- Nucleus -->
  <circle cx="185" cy="182" r="24" fill="url(#dknan)" stroke="#111" stroke-width="2.5"/>
  <text x="185" y="191" text-anchor="middle" font-size="22" font-weight="900" fill="#fff">Na</text>
  <!-- Shell 1 (2e) -->
  <g fill="#334155"><circle cx="185" cy="136" r="6"/><circle cx="185" cy="228" r="6"/></g>
  <!-- Shell 2 (8e) -->
  <g fill="#334155">
    <circle cx="180" cy="102" r="6"/><circle cx="194" cy="103" r="6"/>
    <circle cx="180" cy="262" r="6"/><circle cx="194" cy="261" r="6"/>
    <circle cx="105" cy="176" r="6"/><circle cx="105" cy="190" r="6"/>
    <circle cx="265" cy="176" r="6"/><circle cx="265" cy="190" r="6"/>
  </g>
  <!-- Single outer electron highlighted -->
  <circle cx="299" cy="182" r="16" fill="#facc15" opacity=".4"/>
  <circle cx="299" cy="182" r="9.5" fill="#c8001e" stroke="#111" stroke-width="2.5"/>
  <text x="185" y="318" text-anchor="middle" font-size="19" font-weight="700" fill="#555">11 protons, 11 electrons (neutral)</text>

  <!-- Middle arrow -->
  <path d="M376 172 H466" stroke="#c8001e" stroke-width="8" stroke-linecap="round" marker-end="url(#dknaa)"/>
  <text x="424" y="144" text-anchor="middle" font-size="22" font-weight="900" fill="#c8001e">loses 1 e⁻</text>

  <!-- Right card: [Na]+ ion 2.8 + lost e- -->
  <rect x="488" y="10" width="422" height="320" rx="18" fill="#f5f3ff" stroke="#5e35b1" stroke-width="4.5"/>
  <text x="699" y="42" text-anchor="middle" font-size="24" font-weight="900" fill="#5e35b1">SODIUM ION, Na⁺ (2.8)</text>
  <!-- Brackets around ion -->
  <path d="M558 76 H538 V284 H558" fill="none" stroke="#111" stroke-width="5.5" stroke-linecap="round"/>
  <path d="M726 76 H746 V284 H726" fill="none" stroke="#111" stroke-width="5.5" stroke-linecap="round"/>
  <text x="768" y="96" text-anchor="middle" font-size="44" font-weight="900" fill="#5e35b1">+</text>
  <!-- 2 full shells -->
  <circle cx="642" cy="182" r="46" fill="none" stroke="#94a3b8" stroke-width="3"/>
  <circle cx="642" cy="182" r="80" fill="none" stroke="#5e35b1" stroke-width="3.5"/>
  <circle cx="642" cy="182" r="24" fill="url(#dknan)" stroke="#111" stroke-width="2.5"/>
  <text x="642" y="191" text-anchor="middle" font-size="22" font-weight="900" fill="#fff">Na</text>
  <g fill="#334155">
    <circle cx="642" cy="136" r="6"/><circle cx="642" cy="228" r="6"/>
    <circle cx="637" cy="102" r="6"/><circle cx="651" cy="103" r="6"/>
    <circle cx="637" cy="262" r="6"/><circle cx="651" cy="261" r="6"/>
    <circle cx="562" cy="176" r="6"/><circle cx="562" cy="190" r="6"/>
    <circle cx="722" cy="176" r="6"/><circle cx="722" cy="190" r="6"/>
  </g>
  <!-- Lost electron badge on far right -->
  <text x="802" y="192" text-anchor="middle" font-size="34" font-weight="900" fill="#444">+</text>
  <circle cx="854" cy="182" r="24" fill="url(#dknae)" stroke="#0c4a6e" stroke-width="3"/>
  <text x="854" y="190" text-anchor="middle" font-size="22" font-weight="900" fill="#fff">e⁻</text>
  <text x="699" y="318" text-anchor="middle" font-size="19" font-weight="700" fill="#4a148c">11 protons, 10 electrons → overall 1+</text>
</svg></div><div class="small grey" data-s="3" style="text-align:center">No need to draw the empty outer shell once its electron has gone</div></section>
  <section class="ps" data-nomatch><h2>Chlorine → chloride ion</h2><div class="big">Cl &nbsp; 2.8.<span class="em">7</span> &nbsp;→&nbsp; <span data-s="1">gains 1 electron →</span> <span data-s="2">Cl<sup class="em">−</sup> &nbsp; 2.8.8</span></div><div class="fig mt2" data-s="2" style="flex:1;min-height:0"><svg viewBox="0 0 920 340" style="width:100%;height:100%;max-height:430px;display:block" role="img" aria-label="Chlorine atom (2.8.7) gains one electron to form a chloride ion [Cl]− (2.8.8)" font-family="Barlow,Arial,sans-serif">
  <defs>
    <marker id="dkcla" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#1b5e20"/></marker>
    <radialGradient id="dkcln" cx="35%" cy="30%" r="70%"><stop offset="0%" stop-color="#c8e6c9"/><stop offset="55%" stop-color="#2e7d32"/><stop offset="100%" stop-color="#1b5e20"/></radialGradient>
    <radialGradient id="dkcle" cx="35%" cy="30%" r="70%"><stop offset="0%" stop-color="#e0f2fe"/><stop offset="50%" stop-color="#38bdf8"/><stop offset="100%" stop-color="#0369a1"/></radialGradient>
  </defs>
  <!-- Left card: Cl atom 2.8.7 + incoming e- -->
  <rect x="10" y="10" width="414" height="320" rx="18" fill="#fff" stroke="#111" stroke-width="4.5"/>
  <text x="217" y="42" text-anchor="middle" font-size="24" font-weight="900" fill="#1b5e20">CHLORINE ATOM (2.8.7) + e⁻</text>
  <circle cx="170" cy="182" r="44" fill="none" stroke="#94a3b8" stroke-width="2.8"/>
  <circle cx="170" cy="182" r="76" fill="none" stroke="#64748b" stroke-width="2.8"/>
  <circle cx="170" cy="182" r="108" fill="none" stroke="#2e7d32" stroke-width="3.5"/>
  <circle cx="170" cy="182" r="24" fill="url(#dkcln)" stroke="#111" stroke-width="2.5"/>
  <text x="170" y="191" text-anchor="middle" font-size="22" font-weight="900" fill="#fff">Cl</text>
  <!-- Inner 2 + 8 electrons -->
  <g fill="#334155">
    <circle cx="170" cy="138" r="5.5"/><circle cx="170" cy="226" r="5.5"/>
    <circle cx="164" cy="106" r="5.5"/><circle cx="176" cy="106" r="5.5"/>
    <circle cx="164" cy="258" r="5.5"/><circle cx="176" cy="258" r="5.5"/>
    <circle cx="94" cy="176" r="5.5"/><circle cx="94" cy="188" r="5.5"/>
    <circle cx="246" cy="176" r="5.5"/><circle cx="246" cy="188" r="5.5"/>
  </g>
  <!-- 7 outer electrons + 1 empty gap on right -->
  <g fill="#1b5e20">
    <circle cx="164" cy="74" r="6.5"/><circle cx="178" cy="74" r="6.5"/>
    <circle cx="164" cy="290" r="6.5"/><circle cx="178" cy="290" r="6.5"/>
    <circle cx="62" cy="175" r="6.5"/><circle cx="62" cy="189" r="6.5"/>
    <circle cx="278" cy="173" r="6.5"/>
  </g>
  <circle cx="278" cy="191" r="8" fill="#fef08a" stroke="#c8001e" stroke-width="2.5" stroke-dasharray="3 2"/>
  <!-- Incoming electron -->
  <text x="318" y="191" text-anchor="middle" font-size="32" font-weight="900" fill="#444">+</text>
  <circle cx="368" cy="182" r="24" fill="url(#dkcle)" stroke="#0c4a6e" stroke-width="3"/>
  <text x="368" y="190" text-anchor="middle" font-size="22" font-weight="900" fill="#fff">e⁻</text>
  <text x="217" y="318" text-anchor="middle" font-size="19" font-weight="700" fill="#555">17 protons, 17 electrons (needs 1 more)</text>

  <!-- Middle arrow -->
  <path d="M438 172 H516" stroke="#1b5e20" stroke-width="8" stroke-linecap="round" marker-end="url(#dkcla)"/>
  <text x="480" y="144" text-anchor="middle" font-size="22" font-weight="900" fill="#1b5e20">gains 1 e⁻</text>

  <!-- Right card: [Cl]- ion 2.8.8 -->
  <rect x="536" y="10" width="374" height="320" rx="18" fill="#f0fdf4" stroke="#1b5e20" stroke-width="4.5"/>
  <text x="723" y="42" text-anchor="middle" font-size="24" font-weight="900" fill="#1b5e20">CHLORIDE ION, Cl⁻ (2.8.8)</text>
  <path d="M602 68 H582 V294 H602" fill="none" stroke="#111" stroke-width="5.5" stroke-linecap="round"/>
  <path d="M826 68 H846 V294 H826" fill="none" stroke="#111" stroke-width="5.5" stroke-linecap="round"/>
  <text x="872" y="92" text-anchor="middle" font-size="48" font-weight="900" fill="#1b5e20">−</text>
  <circle cx="714" cy="182" r="44" fill="none" stroke="#94a3b8" stroke-width="2.8"/>
  <circle cx="714" cy="182" r="76" fill="none" stroke="#64748b" stroke-width="2.8"/>
  <circle cx="714" cy="182" r="108" fill="none" stroke="#1b5e20" stroke-width="3.5"/>
  <circle cx="714" cy="182" r="24" fill="url(#dkcln)" stroke="#111" stroke-width="2.5"/>
  <text x="714" y="191" text-anchor="middle" font-size="22" font-weight="900" fill="#fff">Cl</text>
  <g fill="#334155">
    <circle cx="714" cy="138" r="5.5"/><circle cx="714" cy="226" r="5.5"/>
    <circle cx="708" cy="106" r="5.5"/><circle cx="720" cy="106" r="5.5"/>
    <circle cx="708" cy="258" r="5.5"/><circle cx="720" cy="258" r="5.5"/>
    <circle cx="638" cy="176" r="5.5"/><circle cx="638" cy="188" r="5.5"/>
    <circle cx="790" cy="176" r="5.5"/><circle cx="790" cy="188" r="5.5"/>
  </g>
  <g fill="#1b5e20">
    <circle cx="708" cy="74" r="6.5"/><circle cx="722" cy="74" r="6.5"/>
    <circle cx="708" cy="290" r="6.5"/><circle cx="722" cy="290" r="6.5"/>
    <circle cx="606" cy="175" r="6.5"/><circle cx="606" cy="189" r="6.5"/>
    <circle cx="822" cy="173" r="6.5"/>
  </g>
  <!-- Gained electron highlighted in blue -->
  <circle cx="822" cy="193" r="13" fill="#38bdf8" opacity=".4"/>
  <circle cx="822" cy="193" r="8" fill="#0284c7" stroke="#0c4a6e" stroke-width="2.2"/>
  <text x="723" y="318" text-anchor="middle" font-size="19" font-weight="700" fill="#1b5e20">17 protons, 18 electrons → overall 1−</text>
</svg></div><div class="small grey" data-s="3" style="text-align:center">Outer shell is now full (8 electrons) → square brackets &amp; 1− charge</div></section>

  <section class="ps" data-nomatch><h2>Losing or gaining electrons</h2><div class="fig" style="flex:1;min-height:0"><svg viewBox="0 0 1160 500" style="width:100%;height:100%;max-height:560px;display:block" role="img" aria-label="A neutral atom with equal protons and electrons either loses electrons to become a positive cation or gains electrons to become a negative anion" font-family="Barlow,Arial,sans-serif">
  <defs>
    <marker id="dkcag" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#1b5e20"/></marker>
    <marker id="dkcar" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#c8001e"/></marker>
    <radialGradient id="dkcant" cx="35%" cy="30%" r="70%"><stop offset="0%" stop-color="#f1f5f9"/><stop offset="60%" stop-color="#94a3b8"/><stop offset="100%" stop-color="#475569"/></radialGradient>
    <radialGradient id="dkcact" cx="35%" cy="30%" r="70%"><stop offset="0%" stop-color="#c8e6c9"/><stop offset="55%" stop-color="#2e7d32"/><stop offset="100%" stop-color="#1b5e20"/></radialGradient>
    <radialGradient id="dkcaan" cx="35%" cy="30%" r="70%"><stop offset="0%" stop-color="#ffcdd2"/><stop offset="55%" stop-color="#d32f2f"/><stop offset="100%" stop-color="#8e0000"/></radialGradient>
  </defs>

  <!-- TOP CENTRE: NEUTRAL ATOM -->
  <rect x="370" y="14" width="420" height="144" rx="20" fill="#fff" stroke="#111" stroke-width="5"/>
  <circle cx="446" cy="86" r="46" fill="url(#dkcant)" stroke="#111" stroke-width="4"/>
  <text x="446" y="102" text-anchor="middle" font-size="44" font-weight="900" fill="#fff">0</text>
  <text x="634" y="68" text-anchor="middle" font-size="34" font-weight="900" fill="#111">NEUTRAL ATOM</text>
  <text x="634" y="106" text-anchor="middle" font-size="24" font-weight="700" fill="#475569">Protons (+) = Electrons (−)</text>
  <text x="634" y="138" text-anchor="middle" font-size="22" font-weight="700" fill="#64748b">Overall charge = 0</text>

  <!-- Branch arrows -->
  <path d="M460 162 Q330 198 290 250" fill="none" stroke="#1b5e20" stroke-width="8" stroke-linecap="round" marker-end="url(#dkcag)"/>
  <rect x="190" y="178" width="212" height="44" rx="10" fill="#e8f5e9" stroke="#1b5e20" stroke-width="3"/>
  <text x="296" y="208" text-anchor="middle" font-size="24" font-weight="900" fill="#1b5e20">LOSES electrons</text>

  <path d="M700 162 Q830 198 870 250" fill="none" stroke="#c8001e" stroke-width="8" stroke-linecap="round" marker-end="url(#dkcar)"/>
  <rect x="758" y="178" width="212" height="44" rx="10" fill="#fde8eb" stroke="#c8001e" stroke-width="3"/>
  <text x="864" y="208" text-anchor="middle" font-size="24" font-weight="900" fill="#c8001e">GAINS electrons</text>

  <!-- BOTTOM LEFT: POSITIVE CATION -->
  <rect x="28" y="266" width="516" height="218" rx="22" fill="#f0fdf4" stroke="#1b5e20" stroke-width="6"/>
  <circle cx="122" cy="375" r="64" fill="url(#dkcact)" stroke="#111" stroke-width="4.5"/>
  <text x="122" y="400" text-anchor="middle" font-size="74" font-weight="900" fill="#fff">+</text>
  <text x="358" y="328" text-anchor="middle" font-size="44" font-weight="900" fill="#1b5e20">CATION</text>
  <text x="358" y="370" text-anchor="middle" font-size="27" font-weight="800" fill="#111">Positive ion (+)</text>
  <text x="358" y="410" text-anchor="middle" font-size="23" font-weight="700" fill="#334155">More protons than electrons</text>
  <text x="358" y="448" text-anchor="middle" font-size="23" font-weight="800" fill="#1b5e20">Usually METALS (e.g. Na⁺, Mg²⁺)</text>

  <!-- BOTTOM RIGHT: NEGATIVE ANION -->
  <rect x="616" y="266" width="516" height="218" rx="22" fill="#fff5f5" stroke="#c8001e" stroke-width="6"/>
  <circle cx="710" cy="375" r="64" fill="url(#dkcaan)" stroke="#111" stroke-width="4.5"/>
  <text x="710" y="398" text-anchor="middle" font-size="78" font-weight="900" fill="#fff">−</text>
  <text x="946" y="328" text-anchor="middle" font-size="44" font-weight="900" fill="#c8001e">ANION</text>
  <text x="946" y="370" text-anchor="middle" font-size="27" font-weight="800" fill="#111">Negative ion (−)</text>
  <text x="946" y="410" text-anchor="middle" font-size="23" font-weight="700" fill="#334155">More electrons than protons</text>
  <text x="946" y="448" text-anchor="middle" font-size="23" font-weight="800" fill="#c8001e">Usually NON-METALS (e.g. Cl⁻, O²⁻)</text>
</svg></div></section>
  <section class="ps"><div class="two" style="flex:1"><div class="box" style="height:100%;display:flex;flex-direction:column;justify-content:center"><div class="big" style="color:var(--green);font-size:110px;font-family:'Barlow Condensed'">Cations</div><div style="height:300px"><svg viewBox="0 0 254 220" style="width:100%;height:100%" role="img" aria-label="Ions as charged balls" font-family="Barlow,Arial,sans-serif"><defs><radialGradient id="kc1g0" cx=".35" cy=".3"><stop offset="0" stop-color="#fff" stop-opacity=".85"/><stop offset=".45" stop-color="#8e24aa"/><stop offset="1" stop-color="#8e24aa" stop-opacity=".9"/></radialGradient></defs><circle cx="102" cy="110.0" r="72" fill="url(#kc1g0)" stroke="#111" stroke-width="3"/><text x="102" y="125.84" text-anchor="middle" font-size="50" font-weight="900" fill="#fff">Na</text><text x="163.2" y="48.800000000000004" text-anchor="middle" font-size="40" font-weight="900" fill="#111">+</text></svg></div><div class="mid mt2" data-s="1">lost electrons<br>more protons than electrons<br>usually <b>metals</b></div></div><div class="box" style="height:100%;display:flex;flex-direction:column;justify-content:center"><div class="big em" style="font-size:110px;font-family:'Barlow Condensed'">Anions</div><div style="height:300px"><svg viewBox="0 0 254 220" style="width:100%;height:100%" role="img" aria-label="Ions as charged balls" font-family="Barlow,Arial,sans-serif"><defs><radialGradient id="ka1g0" cx=".35" cy=".3"><stop offset="0" stop-color="#fff" stop-opacity=".85"/><stop offset=".45" stop-color="#2e9a46"/><stop offset="1" stop-color="#2e9a46" stop-opacity=".9"/></radialGradient></defs><circle cx="102" cy="110.0" r="72" fill="url(#ka1g0)" stroke="#111" stroke-width="3"/><text x="102" y="125.84" text-anchor="middle" font-size="50" font-weight="900" fill="#fff">Cl</text><text x="163.2" y="48.800000000000004" text-anchor="middle" font-size="40" font-weight="900" fill="#111">−</text></svg></div><div class="mid mt2" data-s="2">gained electrons<br>more electrons than protons<br>usually <b>non-metals</b></div></div></div></section>

  <section class="ps"><h2>Cat-ions are <span class="em">paw-sitive</span></h2><div class="softrow"><figure><img decoding="async" loading="lazy" class="soft" src="img/kitten1.webp" alt="Kitten"></figure><figure data-s="1"><img decoding="async" loading="lazy" class="soft" src="img/kitten2.webp" alt="Kitten"></figure><figure data-s="2"><img decoding="async" loading="lazy" class="soft" src="img/kitten3.webp" alt="Cat"></figure><figure data-s="3"><img decoding="async" loading="lazy" class="soft" src="img/metal-cat.webp" alt="Metal cat sculpture"><figcaption>metal → cat-ion</figcaption></figure></div></section>
  <section class="ps"><h2>Molecules can be ions too</h2><div class="row"><div class="col"><div class="mid">Hydroxide, OH<sup>−</sup>: an oxygen atom joined to a hydrogen atom</div><div class="mid mt" data-s="1">The group has gained <span class="em">one extra electron</span></div><div class="big mt" data-s="2">→ charge of 1−</div><div class="small grey mt" data-s="3">also: NO<sub>3</sub><sup>−</sup>, &nbsp;CO<sub>3</sub><sup>2−</sup>, &nbsp;SO<sub>4</sub><sup>2−</sup>, &nbsp;NH<sub>4</sub><sup>+</sup></div></div><div class="fig"><svg style="width:100%;height:100%" viewBox="0 0 320 200" role="img" aria-label="Ball-and-stick model of a hydroxide ion: a red oxygen atom joined to a white hydrogen atom, with a glowing blue extra electron minus charge" font-family="Barlow,Arial,sans-serif">
<defs><radialGradient id="ohO2" cx="35%" cy="32%" r="70%"><stop offset="0" stop-color="#ff8a80"/><stop offset=".55" stop-color="#e02020"/><stop offset="1" stop-color="#8a0000"/></radialGradient>
<radialGradient id="ohH2" cx="35%" cy="32%" r="70%"><stop offset="0" stop-color="#ffffff"/><stop offset=".6" stop-color="#e6e6e6"/><stop offset="1" stop-color="#9a9a9a"/></radialGradient>
<radialGradient id="ohEGlow" cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#38bdf8" stop-opacity=".85"/><stop offset=".55" stop-color="#0284c7" stop-opacity=".35"/><stop offset="1" stop-color="#0284c7" stop-opacity="0"/></radialGradient>
<radialGradient id="ohE" cx="32%" cy="28%" r="70%"><stop offset="0" stop-color="#e0f2fe"/><stop offset=".4" stop-color="#38bdf8"/><stop offset="1" stop-color="#0369a1"/></radialGradient></defs>
<rect x="128" y="104" width="86" height="16" rx="6" fill="#bdbdbd" stroke="#777" stroke-width="1.5"/>
<circle cx="120" cy="112" r="54" fill="url(#ohO2)"/><text x="120" y="124" text-anchor="middle" font-size="34" font-weight="700" fill="#fff">O</text>
<circle cx="232" cy="112" r="32" fill="url(#ohH2)"/><text x="232" y="122" text-anchor="middle" font-size="26" font-weight="700" fill="#333">H</text>
<circle cx="66" cy="46" r="40" fill="url(#ohEGlow)"/>
<circle cx="66" cy="46" r="22" fill="url(#ohE)" stroke="#0c4a6e" stroke-width="3"/><text x="66" y="57" text-anchor="middle" font-size="38" font-weight="900" fill="#fff">−</text>
</svg></div></div></section>
  <section class="ps"><h2>Metals form cations</h2><div class="fig"><img decoding="async" loading="lazy" src="img/gold.webp" alt="Molten gold being poured"></div><div class="mid mt2">Metals like gold (Au) can lose electrons to form positively charged cations (Au<sup>+</sup>)</div></section>

  <section class="ps"><h2>Ionic or covalent?</h2><div class="fig"><img decoding="async" loading="lazy" src="img/ionic-vs-covalent.webp" alt="Ionic bond: metal + nonmetal. Covalent bond: nonmetal + nonmetal or metalloid + nonmetal"></div><div class="two" style="flex:none;margin-top:20px"><div class="mid em" data-s="1">ionic: electrons TRANSFERRED</div><div class="mid em" data-s="2">covalent: electrons SHARED</div></div></section>

  <section class="ps"><h2>Electron transfer</h2><div class="fig"><video preload="none" src="img/naf-transfer.mp4" autoplay muted loop playsinline></video></div><div class="mid" style="text-align:center;line-height:1.35">The metal (Na) <b>loses</b> an electron → cation Na<sup>+</sup><br>The non-metal (F) <b>gains</b> it → anion F<sup>−</sup></div></section>
  <section class="ps"><i class="stag da"></i><h2>Setting it out</h2><div class="fig"><img decoding="async" loading="lazy" src="img/nacl-dotcross.webp" alt="Sodium and chlorine atoms become [Na]+ and [Cl]− ions"></div></section>
  <section class="ps"><i class="stag da"></i><h2>Dot &amp; cross: sodium chloride</h2><div class="overlay"><div class="fig" data-comp="ionic" data-k="NaCl" data-view="before" data-arrow-step="1" data-hide-from="2"></div><div class="fig" data-comp="ionic" data-k="NaCl" data-view="after" data-s="2"></div></div><div class="small" data-s="3">Brackets + charges &nbsp;|&nbsp; anion has 8 outer electrons &nbsp;|&nbsp; no shell needed for the metal ion</div></section>
  <section class="ps"><i class="stag da"></i><i class="sico wb"></i><h2>Your turn: <span class="em">sodium fluoride</span> <span class="nt">NaF</span></h2><div class="overlay"><div class="fig" data-comp="ionic" data-k="NaF" data-view="before" data-arrow-step="1" data-hide-from="2"></div><div class="fig" data-comp="ionic" data-k="NaF" data-view="after" data-s="2"></div></div></section>
  <section class="ps"><i class="stag da"></i><i class="sico wb"></i><h2>Your turn: <span class="em">magnesium oxide</span> <span class="nt">MgO</span></h2><div class="overlay"><div class="fig" data-comp="ionic" data-k="MgO" data-view="before" data-arrow-step="1" data-hide-from="2"></div><div class="fig" data-comp="ionic" data-k="MgO" data-view="after" data-s="2"></div></div></section>
  <section class="ps"><i class="stag da"></i><i class="sico wb"></i><h2>Your turn: <span class="em">calcium chloride</span> <span class="nt">CaCl<sub>2</sub></span></h2><div class="overlay"><div class="fig" data-comp="ionic" data-k="CaCl2" data-view="before" data-arrow-step="1" data-hide-from="2"></div><div class="fig" data-comp="ionic" data-k="CaCl2" data-view="after" data-s="2"></div></div></section>
  <section class="ps"><i class="stag da"></i><h2>Calcium chloride, by hand</h2><div class="fig"><img decoding="async" loading="lazy" src="img/cacl2-handdrawn.webp" alt="Hand-drawn CaCl2 dot-and-cross"></div></section>
  <section class="ps"><i class="stag da"></i><i class="sico wb"></i><h2>Your turn: <span class="em">sodium oxide</span> <span class="nt">Na<sub>2</sub>O</span></h2><div class="overlay"><div class="fig" data-comp="ionic" data-k="Na2O" data-view="before" data-arrow-step="1" data-hide-from="2"></div><div class="fig" data-comp="ionic" data-k="Na2O" data-view="after" data-s="2"></div></div></section>

  <section class="ps"><h2>Charge from the group</h2><table class="cmp" style="margin-top:30px"><thead><tr><th>Group</th><th>1</th><th>2</th><th>3</th><th>5</th><th>6</th><th>7</th></tr></thead><tbody><tr><th>Charge</th><td data-s="1">1+</td><td data-s="1">2+</td><td data-s="1">3+</td><td data-s="2">3−</td><td data-s="2">2−</td><td data-s="2">1−</td></tr><tr><th>Example</th><td data-s="1">Na<sup>+</sup></td><td data-s="1">Mg<sup>2+</sup></td><td data-s="1">Al<sup>3+</sup></td><td data-s="2">N<sup>3−</sup></td><td data-s="2">O<sup>2−</sup></td><td data-s="2">Cl<sup>−</sup></td></tr></tbody></table></section>

  <section class="ps" data-nomatch><h2>Ion charges</h2><div class="fig"><div class="ptwrap"><img decoding="async" loading="lazy" src="img/ion-periodic-table.webp" alt="Periodic table of ion charges"><div class="blank" data-hide-from="1" style="left:15.3%;top:0;width:50.2%;height:100%"></div><div class="blank" data-hide-from="1" style="left:90.2%;top:0;width:9.8%;height:100%"></div></div></div><div class="small grey" style="text-align:center" data-hide-from="1">Groups 1, 2 and 3–7: work these out from the group number</div></section>
  <section class="ps"><h2>Simulation: ion model</h2><div style="margin:auto 0"><a class="linkcard" href="https://javalab.org/en/ion_model_en/" target="_blank" rel="noopener"><img decoding="async" loading="lazy" src="img/sim-ion-model.webp" alt=""><span class="lt"><b>Simulation</b>Ion model: build ions and match them into compounds<small>javalab.org ↗</small></span></a></div></section>
  <section class="ps"><i class="stag da"></i><h2>Positive ions to learn</h2><div class="row"><div class="col mid">1+ &nbsp;<b>S</b>ilver, <b>H</b>ydrogen, <b>A</b>mmonium<br>2+ &nbsp;<b>C</b>opper, <b>Z</b>inc, <b>L</b>ead, <b>I</b>ron(II)<br>3+ &nbsp;<b>I</b>ron(III)</div><div class="col big em" data-s="1">small hen and<br>cool zebra ina lemon –<br>illegal!</div><div class="fig" data-s="2" style="flex:1"><img decoding="async" loading="lazy" src="img/mnemonic-positive.webp" alt="Zebra in a lemon and police officer: ILLEGAL!"></div></div></section>
  <section class="ps"><h2>Negative ions to learn</h2><div class="row"><div class="col mid" style="flex:.8">1− &nbsp;<b>N</b>itrate, <b>H</b>ydroxide<br>2− &nbsp;<b>C</b>arbonate, <b>S</b>ulfate</div><div class="fig" data-s="1" style="flex:1.6"><img decoding="async" loading="lazy" src="img/mnemonic-negative.webp" alt="Witches at a cake sale: NO HEX"></div></div></section>

  <section class="ps"><h2>Ionic compounds</h2><div class="row"><div class="col" style="flex:1.3"><div class="small">Ionic compounds form when <b>metals</b> react with <b>non-metals</b></div><div class="small mt2" data-s="1">The metal <span class="em">loses</span> electrons to form a <b>cation</b></div><div class="small mt2" data-s="2">The non-metal <span class="em">gains</span> electrons to form an <b>anion</b></div><div class="small mt2" data-s="3">Cations and anions are <b>strongly attracted</b> to each other (<span class="em">electrostatic attraction</span>), forming an <b>ionic bond</b></div></div><div class="fig" style="flex-direction:column"><img decoding="async" loading="lazy" src="img/naf-lattice.webp" alt="Sodium fluoride lattice" style="max-height:520px"><div class="small grey">Sodium fluoride (NaF)</div></div></div></section>
  <section class="ps"><h2>Ionic lattices</h2><div class="row"><div class="col" style="flex:1.5"><div class="small">Ionic compounds form <b>giant lattice structures</b></div><div class="small mt2" data-s="1">Ions with opposite charges are closely packed together in a <b>3D arrangement</b></div><div class="small mt2" data-s="2">The electrostatic attraction between ions is <span class="em">very strong</span></div><div class="small mt2" data-s="3">Lots of energy is needed to overcome it → <span class="em">very high melting and boiling points</span></div><div class="small mt2" data-s="4">They <b>do not conduct</b> electricity when <b>solid</b></div><div class="small mt2" data-s="5">They <b>do conduct</b> when <b>dissolved in water</b> or <b>molten</b></div></div><div class="fig" style="flex-direction:column"><img decoding="async" loading="lazy" src="img/lattice.webp" alt="Giant ionic lattice" style="max-height:560px"><div class="small grey" style="font-size:26px">positive ions are electrostatically attracted to negative ions</div></div></div></section>
  <section class="ps darkbg" data-nomatch style="background:#161616"><h2>Ionic compounds form crystals</h2><div class="imrow"><div><img decoding="async" loading="lazy" src="img/salt-crystals.webp" alt="Salt crystals"></div><div data-s="1" style="flex:1.4"><img decoding="async" loading="lazy" src="img/coloured-salts.webp" alt="Coloured ionic crystals"></div></div></section>
  <section class="ps"><h2>Simulation: ions forming crystals</h2><div style="margin:auto 0"><a class="linkcard" href="https://sciencedemos.org.uk/ions.php" target="_blank" rel="noopener"><img decoding="async" loading="lazy" src="img/sim-crystals.webp" alt=""><span class="lt"><b>Simulation</b>Ions forming crystals: watch ions arrange into a lattice<small>sciencedemos.org.uk ↗</small></span></a></div></section>
  <section class="ps"><h2>Why high melting points?</h2><div class="row" style="align-items:flex-start;gap:40px"><div style="flex:1.75"><table class="cmp mptab" style="font-size:25px"><thead><tr><th>Substance</th><th>Structure</th><th>Melting point / °C</th></tr></thead><tbody><tr><th>Graphite <span style="font-weight:400">C</span></th><td><span class="stype" style="background:#5b5b5b">Giant covalent</span></td><td style="background:rgb(200,20,30);color:#fff;font-weight:700;text-align:right">≈ 3650 (sublimes)</td></tr><tr><th>Diamond <span style="font-weight:400">C</span></th><td><span class="stype" style="background:#5b5b5b">Giant covalent</span></td><td style="background:rgb(201,26,35);color:#fff;font-weight:700;text-align:right">≈ 3550</td></tr><tr><th>Magnesium oxide <span style="font-weight:400">MgO</span></th><td><span class="stype" style="background:#c8001e">Ionic</span></td><td style="background:rgb(211,67,68);color:#fff;font-weight:700;text-align:right">2852</td></tr><tr><th>Silicon dioxide <span style="font-weight:400">SiO<sub>2</sub></span></th><td><span class="stype" style="background:#5b5b5b">Giant covalent</span></td><td style="background:rgb(228,134,123);color:#111;font-weight:700;text-align:right">1710</td></tr><tr><th>Sodium chloride <span style="font-weight:400">NaCl</span></th><td><span class="stype" style="background:#c8001e">Ionic</span></td><td style="background:rgb(241,188,166);color:#111;font-weight:700;text-align:right">801</td></tr><tr><th>Calcium chloride <span style="font-weight:400">CaCl<sub>2</sub></span></th><td><span class="stype" style="background:#c8001e">Ionic</span></td><td style="background:rgb(241,190,168);color:#111;font-weight:700;text-align:right">772</td></tr><tr><th>Water <span style="font-weight:400">H<sub>2</sub>O</span></th><td><span class="stype" style="background:#4aa3ff">Simple molecular</span></td><td style="background:rgb(252,235,204);color:#111;font-weight:700;text-align:right">0</td></tr><tr><th>Carbon dioxide <span style="font-weight:400">CO<sub>2</sub></span></th><td><span class="stype" style="background:#4aa3ff">Simple molecular</span></td><td style="background:rgb(253,240,208);color:#111;font-weight:700;text-align:right">−78 (sublimes)</td></tr><tr><th>Methane <span style="font-weight:400">CH<sub>4</sub></span></th><td><span class="stype" style="background:#4aa3ff">Simple molecular</span></td><td style="background:rgb(255,246,213);color:#111;font-weight:700;text-align:right">−182</td></tr></tbody></table></div><div class="col"><div style="font-size:28px;font-weight:600;line-height:1.25"><span class="stype" style="background:#c8001e">Ionic</span><br>many <b>strong</b> attractions between ions → high</div><div class="mt2" style="font-size:28px;font-weight:600;line-height:1.25" data-s="1"><span class="stype" style="background:#5b5b5b">Giant covalent</span><br>many strong covalent bonds → very high</div><div class="mt2" style="font-size:28px;font-weight:600;line-height:1.25" data-s="2"><span class="stype" style="background:#4aa3ff">Simple molecular</span><br>only <b>weak forces between molecules</b> → low</div><div class="mt2 grey" style="font-size:28px;font-weight:600;line-height:1.25" data-s="3">MgO (2+ and 2− ions) &gt; NaCl (1+ and 1−)</div></div></div></section>
  <section class="ps"><i class="stag da"></i><h2>Does it conduct?</h2><div class="row" style="align-items:flex-start"><div class="fig" style="flex:1.3;flex-direction:column;align-items:stretch" data-comp="ion-conduction"></div><div class="col"><div class="mid" data-s="1">Solid: <b>no</b><br><span class="small grey">ions in fixed positions</span></div><div class="mid mt" data-s="2">Molten / dissolved: <b class="em">yes</b><br><span class="small grey">ions free to move</span></div></div></div></section>
  <section class="ps"><i class="stag da"></i><h2>Test it: which substances conduct?</h2><div class="row" style="flex:1;min-height:0;gap:28px"><div class="col" style="flex:.62"><div class="mid">Switch the substance in the circuit</div><ul class="ilist sm mt"><li><b>Ionic solid:</b> ions locked → <b>no</b></li><li><b>Ionic (aq) / molten:</b> mobile ions → <b style="color:#1b5e20">yes</b></li><li><b>Covalent liquids:</b> neutral molecules → <b>no</b></li><li><b>Graphite:</b> delocalised e⁻ → <b style="color:#1b5e20">yes</b></li></ul></div><div class="fig" style="flex:1.45" data-comp="conduct-test" data-default="nacl_s"></div></div></section>
  <section class="ps" data-nomatch><i class="stag da"></i><i class="sico qc"></i><h2>Solid vs <span class="em">molten</span> NaCl</h2><div class="row" style="flex:1;min-height:0;gap:34px;align-items:center"><div class="fig" style="flex:.95;background:#fff;border:5px solid #111;border-radius:16px;padding:18px;height:100%"><svg viewBox="0 0 540 420" style="width:100%;height:100%;display:block" role="img" aria-label="Comparison of solid NaCl lattice with fixed ions and molten NaCl with free-moving ions" font-family="Barlow,Arial,sans-serif"><defs><radialGradient id="qcNa" cx=".35" cy=".3"><stop offset="0" stop-color="#d1c4e9"/><stop offset="1" stop-color="#5e35b1"/></radialGradient><radialGradient id="qcCl" cx=".35" cy=".3"><stop offset="0" stop-color="#c8e6c9"/><stop offset="1" stop-color="#2e7d32"/></radialGradient><marker id="qcArr" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#c8001e"/></marker></defs><rect x="10" y="10" width="248" height="400" rx="14" fill="#fafafa" stroke="#111" stroke-width="4"/><text x="134" y="48" text-anchor="middle" font-size="28" font-weight="900" fill="#c62828">SOLID NaCl</text><text x="134" y="76" text-anchor="middle" font-size="20" font-weight="700" fill="#555">Bulb OFF</text><g transform="translate(34,104)"><circle cx="42" cy="40" r="24" fill="url(#qcNa)" stroke="#111" stroke-width="2.5"/><text x="42" y="47" text-anchor="middle" font-size="18" font-weight="900" fill="#fff">+</text><circle cx="100" cy="40" r="30" fill="url(#qcCl)" stroke="#111" stroke-width="2.5"/><text x="100" y="48" text-anchor="middle" font-size="22" font-weight="900" fill="#fff">−</text><circle cx="158" cy="40" r="24" fill="url(#qcNa)" stroke="#111" stroke-width="2.5"/><text x="158" y="47" text-anchor="middle" font-size="18" font-weight="900" fill="#fff">+</text><circle cx="42" cy="106" r="30" fill="url(#qcCl)" stroke="#111" stroke-width="2.5"/><text x="42" y="114" text-anchor="middle" font-size="22" font-weight="900" fill="#fff">−</text><circle cx="100" cy="106" r="24" fill="url(#qcNa)" stroke="#111" stroke-width="2.5"/><text x="100" y="113" text-anchor="middle" font-size="18" font-weight="900" fill="#fff">+</text><circle cx="158" cy="106" r="30" fill="url(#qcCl)" stroke="#111" stroke-width="2.5"/><text x="158" y="114" text-anchor="middle" font-size="22" font-weight="900" fill="#fff">−</text><circle cx="42" cy="172" r="24" fill="url(#qcNa)" stroke="#111" stroke-width="2.5"/><text x="42" y="179" text-anchor="middle" font-size="18" font-weight="900" fill="#fff">+</text><circle cx="100" cy="172" r="30" fill="url(#qcCl)" stroke="#111" stroke-width="2.5"/><text x="100" y="180" text-anchor="middle" font-size="22" font-weight="900" fill="#fff">−</text><circle cx="158" cy="172" r="24" fill="url(#qcNa)" stroke="#111" stroke-width="2.5"/><text x="158" y="179" text-anchor="middle" font-size="18" font-weight="900" fill="#fff">+</text></g><rect x="26" y="344" width="216" height="46" rx="10" fill="#fde8eb" stroke="#c62828" stroke-width="3"/><text x="134" y="374" text-anchor="middle" font-size="22" font-weight="900" fill="#c62828">Fixed in lattice</text><rect x="282" y="10" width="248" height="400" rx="14" fill="#f1f8e9" stroke="#111" stroke-width="4"/><text x="406" y="48" text-anchor="middle" font-size="28" font-weight="900" fill="#1b5e20">MOLTEN NaCl</text><text x="406" y="76" text-anchor="middle" font-size="20" font-weight="700" fill="#1b5e20">Bulb ON</text><rect x="294" y="98" width="22" height="226" rx="4" fill="#37474f" stroke="#111" stroke-width="2.5"/><text x="305" y="122" text-anchor="middle" font-size="22" font-weight="900" fill="#fff">−</text><rect x="496" y="98" width="22" height="226" rx="4" fill="#37474f" stroke="#111" stroke-width="2.5"/><text x="507" y="122" text-anchor="middle" font-size="22" font-weight="900" fill="#fff">+</text><g><line x1="392" y1="138" x2="334" y2="138" stroke="#c8001e" stroke-width="4.5" marker-end="url(#qcArr)"/><circle cx="404" cy="138" r="22" fill="url(#qcNa)" stroke="#111" stroke-width="2.5"/><text x="404" y="145" text-anchor="middle" font-size="18" font-weight="900" fill="#fff">+</text><line x1="416" y1="204" x2="476" y2="204" stroke="#c8001e" stroke-width="4.5" marker-end="url(#qcArr)"/><circle cx="394" cy="204" r="28" fill="url(#qcCl)" stroke="#111" stroke-width="2.5"/><text x="394" y="212" text-anchor="middle" font-size="22" font-weight="900" fill="#fff">−</text><line x1="422" y1="276" x2="342" y2="276" stroke="#c8001e" stroke-width="4.5" marker-end="url(#qcArr)"/><circle cx="436" cy="276" r="22" fill="url(#qcNa)" stroke="#111" stroke-width="2.5"/><text x="436" y="283" text-anchor="middle" font-size="18" font-weight="900" fill="#fff">+</text></g><rect x="298" y="344" width="216" height="46" rx="10" fill="#e8f5e9" stroke="#1b5e20" stroke-width="3"/><text x="406" y="374" text-anchor="middle" font-size="22" font-weight="900" fill="#1b5e20">Ions free to move</text></svg></div><div class="col" style="flex:1.15;display:flex;flex-direction:column;gap:16px"><div class="mid" style="font-size:40px">Why does molten NaCl conduct, while solid NaCl does <b>not</b>?</div><div class="opts" style="grid-template-columns:1fr;gap:14px;margin-top:4px"><div class="opt" style="font-size:34px;padding:14px 20px"><b>A</b><span>Solid NaCl has no electrons to carry charge</span></div><div class="opt correct" data-s="1" style="font-size:34px;padding:14px 20px"><b>B</b><span>When molten, the <b>ions</b> are free to move and carry charge</span></div><div class="opt" style="font-size:34px;padding:14px 20px"><b>C</b><span>Melting turns the ions into covalent molecules</span></div></div><div data-s="1" style="background:#fff3e0;border:4px solid #c62828;border-left:16px solid #c62828;border-radius:12px;padding:14px 20px;font:800 28px/1.25 'Barlow',sans-serif;color:#8c0013">⚠ EXAMINER TRAP: NEVER say "electrons move" in ionic compounds — it is IONS that move!</div></div></div></section>

  <section class="ps"><h2>Formulae: balance the charges</h2><div class="big">Calcium chloride</div><div class="big mt">Ca<sup>2+</sup> &nbsp; Cl<sup>−</sup></div><div class="mid mt" data-s="1">need <b>2</b> Cl<sup>−</sup> to cancel 2+ → total charge 0</div><div class="row" style="flex:none"><div class="big em mt" data-s="2" style="font-size:110px">CaCl<sub>2</sub></div><img decoding="async" loading="lazy" src="img/white-crystals.webp" alt="" data-s="2" style="height:230px;margin-left:auto"></div></section>
  <section class="ps"><i class="sico wb"></i><h2>Your turn: <span class="em">aluminium oxide</span></h2><div class="mid" style="margin-bottom:6px">Balance the ion charges on your whiteboard and write the <b>ionic formula</b>, then click to check.</div><div class="big">Al<sup>3+</sup> &nbsp; O<sup>2−</sup></div><div style="height:260px" data-s="1"><svg viewBox="0 0 1000 280" style="width:100%;height:100%" role="img" aria-label="Ions as charged balls" font-family="Barlow,Arial,sans-serif"><defs><radialGradient id="alog0" cx=".35" cy=".3"><stop offset="0" stop-color="#fff" stop-opacity=".85"/><stop offset=".45" stop-color="#9e9e9e"/><stop offset="1" stop-color="#9e9e9e" stop-opacity=".9"/></radialGradient></defs><circle cx="102" cy="140.0" r="72" fill="url(#alog0)" stroke="#111" stroke-width="3"/><text x="102" y="155.84" text-anchor="middle" font-size="50" font-weight="900" fill="#fff">Al</text><text x="163.2" y="78.80000000000001" text-anchor="middle" font-size="40" font-weight="900" fill="#111">3+</text><defs><radialGradient id="alog1" cx=".35" cy=".3"><stop offset="0" stop-color="#fff" stop-opacity=".85"/><stop offset=".45" stop-color="#9e9e9e"/><stop offset="1" stop-color="#9e9e9e" stop-opacity=".9"/></radialGradient></defs><circle cx="276" cy="140.0" r="72" fill="url(#alog1)" stroke="#111" stroke-width="3"/><text x="276" y="155.84" text-anchor="middle" font-size="50" font-weight="900" fill="#fff">Al</text><text x="337.2" y="78.80000000000001" text-anchor="middle" font-size="40" font-weight="900" fill="#111">3+</text><defs><radialGradient id="alog2" cx=".35" cy=".3"><stop offset="0" stop-color="#fff" stop-opacity=".85"/><stop offset=".45" stop-color="#e53935"/><stop offset="1" stop-color="#e53935" stop-opacity=".9"/></radialGradient></defs><circle cx="500" cy="140.0" r="72" fill="url(#alog2)" stroke="#111" stroke-width="3"/><text x="500" y="155.84" text-anchor="middle" font-size="50" font-weight="900" fill="#fff">O</text><text x="561.2" y="78.80000000000001" text-anchor="middle" font-size="40" font-weight="900" fill="#111">2−</text><defs><radialGradient id="alog3" cx=".35" cy=".3"><stop offset="0" stop-color="#fff" stop-opacity=".85"/><stop offset=".45" stop-color="#e53935"/><stop offset="1" stop-color="#e53935" stop-opacity=".9"/></radialGradient></defs><circle cx="674" cy="140.0" r="72" fill="url(#alog3)" stroke="#111" stroke-width="3"/><text x="674" y="155.84" text-anchor="middle" font-size="50" font-weight="900" fill="#fff">O</text><text x="735.2" y="78.80000000000001" text-anchor="middle" font-size="40" font-weight="900" fill="#111">2−</text><defs><radialGradient id="alog4" cx=".35" cy=".3"><stop offset="0" stop-color="#fff" stop-opacity=".85"/><stop offset=".45" stop-color="#e53935"/><stop offset="1" stop-color="#e53935" stop-opacity=".9"/></radialGradient></defs><circle cx="848" cy="140.0" r="72" fill="url(#alog4)" stroke="#111" stroke-width="3"/><text x="848" y="155.84" text-anchor="middle" font-size="50" font-weight="900" fill="#fff">O</text><text x="909.2" y="78.80000000000001" text-anchor="middle" font-size="40" font-weight="900" fill="#111">2−</text></svg></div><div class="mid mt2" data-s="1">2 × 3+ = 6+ &nbsp; and &nbsp; 3 × 2− = 6−</div><div class="big em mt2" data-s="2" style="font-size:100px">Al<sub>2</sub>O<sub>3</sub></div></section>
  <section class="ps"><i class="sico wb"></i><h2>Your turn: <span class="em">barium nitrate</span></h2><div class="mid" style="margin-bottom:6px">Balance the ion charges on your whiteboard and write the <b>ionic formula</b> (remember brackets!), then click to check.</div><div class="big">Ba<sup>2+</sup> &nbsp; NO<sub>3</sub><sup>−</sup></div><div style="height:260px" data-s="1"><svg viewBox="0 0 652 280" style="width:100%;height:100%" role="img" aria-label="Ions as charged balls" font-family="Barlow,Arial,sans-serif"><defs><radialGradient id="bnog0" cx=".35" cy=".3"><stop offset="0" stop-color="#fff" stop-opacity=".85"/><stop offset=".45" stop-color="#2e7d32"/><stop offset="1" stop-color="#2e7d32" stop-opacity=".9"/></radialGradient></defs><circle cx="102" cy="140.0" r="72" fill="url(#bnog0)" stroke="#111" stroke-width="3"/><text x="102" y="155.84" text-anchor="middle" font-size="50" font-weight="900" fill="#fff">Ba</text><text x="163.2" y="78.80000000000001" text-anchor="middle" font-size="40" font-weight="900" fill="#111">2+</text><defs><radialGradient id="bnog1" cx=".35" cy=".3"><stop offset="0" stop-color="#fff" stop-opacity=".85"/><stop offset=".45" stop-color="#1e5bd8"/><stop offset="1" stop-color="#1e5bd8" stop-opacity=".9"/></radialGradient></defs><circle cx="326" cy="140.0" r="72" fill="url(#bnog1)" stroke="#111" stroke-width="3"/><text x="326" y="155.84" text-anchor="middle" font-size="40" font-weight="900" fill="#fff">NO₃</text><text x="387.2" y="78.80000000000001" text-anchor="middle" font-size="40" font-weight="900" fill="#111">−</text><defs><radialGradient id="bnog2" cx=".35" cy=".3"><stop offset="0" stop-color="#fff" stop-opacity=".85"/><stop offset=".45" stop-color="#1e5bd8"/><stop offset="1" stop-color="#1e5bd8" stop-opacity=".9"/></radialGradient></defs><circle cx="500" cy="140.0" r="72" fill="url(#bnog2)" stroke="#111" stroke-width="3"/><text x="500" y="155.84" text-anchor="middle" font-size="40" font-weight="900" fill="#fff">NO₃</text><text x="561.2" y="78.80000000000001" text-anchor="middle" font-size="40" font-weight="900" fill="#111">−</text></svg></div><div class="mid mt2" data-s="1">need <b>2</b> NO<sub>3</sub><sup>−</sup> → brackets!</div><div class="big em mt2" data-s="2" style="font-size:100px">Ba(NO<sub>3</sub>)<sub>2</sub></div></section>
  <section class="ps"><i class="sico wb"></i><h2>Write the chemical formula (1 of 2)</h2><div class="mid" style="margin-bottom:14px"><b class="em">Your turn:</b> use the ion charges to balance each one, then click to check.</div><div class="row" style="align-items:center;gap:30px"><div style="flex:1.25;font-size:42px;font-weight:600;line-height:1.3"><div style="margin:6px 0">1. Sodium and chlorine <span class="em" data-s="1">NaCl</span></div><div style="margin:6px 0">2. Magnesium and oxygen <span class="em" data-s="1">MgO</span></div><div style="margin:6px 0">3. Calcium and fluorine <span class="em" data-s="1">CaF<sub>2</sub></span></div><div style="margin:6px 0">4. Potassium and bromine <span class="em" data-s="1">KBr</span></div><div style="margin:6px 0">5. Aluminium and oxygen <span class="em" data-s="1">Al<sub>2</sub>O<sub>3</sub></span></div><div style="margin:6px 0">6. Lithium and nitrogen <span class="em" data-s="1">Li<sub>3</sub>N</span></div><div style="margin:6px 0">7. Barium and sulfur <span class="em" data-s="1">BaS</span></div><div style="margin:6px 0">8. Sodium and sulfur <span class="em" data-s="1">Na<sub>2</sub>S</span></div></div><div class="fig" style="flex:1"><img decoding="async" loading="lazy" src="img/ion-periodic-table.webp" alt="Ion charges on the periodic table"></div></div></section>
  <section class="ps"><i class="sico wb"></i><h2>Write the chemical formula (2 of 2)</h2><div class="mid" style="margin-bottom:14px"><b class="em">Your turn:</b> use the ion charges to balance each one, then click to check.</div><div class="row" style="align-items:center;gap:30px"><div style="flex:1.25;font-size:42px;font-weight:600;line-height:1.3"><div style="margin:6px 0">9. Magnesium and chlorine <span class="em" data-s="1">MgCl<sub>2</sub></span></div><div style="margin:6px 0">10. Calcium and iodine <span class="em" data-s="1">CaI<sub>2</sub></span></div><div style="margin:6px 0">11. Aluminium and fluorine <span class="em" data-s="1">AlF<sub>3</sub></span></div><div style="margin:6px 0">12. Potassium and oxygen <span class="em" data-s="1">K<sub>2</sub>O</span></div><div style="margin:6px 0">13. Lithium and bromine <span class="em" data-s="1">LiBr</span></div><div style="margin:6px 0">14. Barium and nitrate <span class="em" data-s="1">Ba(NO<sub>3</sub>)<sub>2</sub></span></div><div style="margin:6px 0">15. Ammonium and chlorine <span class="em" data-s="1">NH<sub>4</sub>Cl</span></div></div><div class="fig" style="flex:1"><img decoding="async" loading="lazy" src="img/ion-periodic-table.webp" alt="Ion charges on the periodic table"></div></div></section>

